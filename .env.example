# =============================================================
# obsidian-yk-script - .env.example
# =============================================================
# 复制为 .env 并填实际值: cp .env.example .env
# yk-script 通过 systemd EnvironmentFile 加载

# ===== LLM (MiniMax) =====
# 老板 2026-06-17 提供
MINIMAXI_API_KEY=sk-cp-...msWk         # 老板提供真实 key 后替换
MINIMAXI_BASE_URL=https://api.minimaxi.com/v1
MINIMAXI_TEXT_MODEL=MiniMax-M3

# Writer / Critic 调参
WRITER_TEMPERATURE=0.8
WRITER_MAX_TOKENS=4000
WRITER_N_CANDIDATES=3
CRITIC_TEMPERATURE=0.3
CRITIC_THRESHOLD=7.5
CRITIC_MAX_ROUNDS=3

# ===== P11: GitHub 拉大纲 =====
# 仅需 obsidian-yk-script 仓的 Read 权限 (fine-grained PAT)
GITHUB_OUTLINE_REPO=blackclaw0318/obsidian-yk-script

# ===== P12: 推送到 obsidian-journal =====
# OBSIDIAN_PUBLISH_SECRET 在 obsidian-journal 仓的管理面板生成 (HMAC 共享密钥)
OBSIDIAN_PUBLISH_URL=https://www.shangkun.uk/api/external/posts
OBSIDIAN_PUBLISH_SECRET=                # 填 obsidian-journal 管理后台生成的 hex
YK_PUBLISHER_ID=yk-script

# ===== P13: GitHub 备份 =====
# 仅需 obsidian-novel-backups 私仓 Contents: Read+Write 权限
GITHUB_BACKUP_TOKEN=                    # 填 fine-grained PAT
GITHUB_BACKUP_REPO=blackclaw0318/obsidian-novel-backups
GITHUB_BACKUP_ENABLED=true

# ===== P14: 微信通知 =====
# 老板手动注册 cron job 后, 把 job id 填到这里
# 见 docs/OPERATIONS_RUNBOOK.md § "注册微信通知 job"
WEIXIN_NOTIFY_ENABLED=true
YK_WEIXIN_CRON_JOB_ID=                  # 注册后填, e.g. a1b2c3d4-...
YK_WEIXIN_PENDING_FILE=                  # 可选, 默认 logs/wechat-pending.txt
WEIXIN_CRON_RUN_TIMEOUT_S=15

# ===== 调度 =====
PUBLISH_TIME=06:00
TIMEZONE=Asia/Shanghai
CURRENT_SEASON=1

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
