# ============================================================
# obsidian-yk-script 环境变量模板 (v0.3)
# ============================================================
# 复制: cp .env.example .env  然后填入真实值
# .env 已在 .gitignore 中
# 与 obsidian-novel-publisher 共享同一份凭据即可
# ============================================================

# ──────────────────────────────────────────────────────────────
# 1. LLM (minimax) — 写作优化 M2.7 (不选 M3 Coding 优化)
# ──────────────────────────────────────────────────────────────
MINIMAXI_API_KEY=sk-cp-...
MINIMAXI_BASE_URL=https://api.minimaxi.com/anthropic    # ← Anthropic 兼容
MINIMAXI_TEXT_MODEL=MiniMax-M2.7                         # ← 写小说专用 60 TPS

# ──────────────────────────────────────────────────────────────
# 2. obsidian-journal 接收侧 (HMAC 鉴权)
# ──────────────────────────────────────────────────────────────
OBSIDIAN_PUBLISH_URL=https://shangkun.uk/api/external/posts
YK_PUBLISHER_ID=yk-script
OBSIDIAN_PUBLISH_SECRET=change-me-32-bytes-random-hex   # ← 与 publisher 一致

# ──────────────────────────────────────────────────────────────
# 3. 🆕 GitHub 备份 (v0.3)
# ──────────────────────────────────────────────────────────────
# PAT scope 要求 (双开):
#   - obsidian-yk-script (read) — 拉大纲
#   - obsidian-novel-backups (read+write) — 备份每日生成内容
GITHUB_BACKUP_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
GITHUB_BACKUP_REPO=blackclaw0318/obsidian-novel-backups
GITHUB_BACKUP_ENABLED=true
GITHUB_OUTLINE_REPO=blackclaw0318/obsidian-yk-script    # ← 大纲所在仓

# ──────────────────────────────────────────────────────────────
# 4. 🆕 微信推送 (v0.3)
# ──────────────────────────────────────────────────────────────
# 在 OpenClaw 控制台创建 cron job 后填入 jobId
WEIXIN_NOTIFY_ENABLED=true
YK_WEIXIN_CRON_JOB_ID=                                  # ← 创建后填入,空则跳过
YK_WEIXIN_PENDING_FILE=./logs/yk-wechat-pending.txt
WEIXIN_CRON_RUN_TIMEOUT_S=15

# ──────────────────────────────────────────────────────────────
# 5. 调度 (systemd timer)
# ──────────────────────────────────────────────────────────────
PUBLISH_TIME=06:00
TIMEZONE=Asia/Shanghai
CURRENT_SEASON=1

# ──────────────────────────────────────────────────────────────
# 6. LLM 调用参数
# ──────────────────────────────────────────────────────────────
WRITER_TEMPERATURE=0.9
WRITER_MAX_TOKENS=4000
WRITER_N_CANDIDATES=3
CRITIC_TEMPERATURE=0.3
CRITIC_THRESHOLD=38
CRITIC_MAX_ROUNDS=2

# ──────────────────────────────────────────────────────────────
# 7. 日志
# ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_MAX_BYTES=10485760      # 10 MB
LOG_BACKUP_COUNT=5          # 滚动 5 个